# Sources include project headers by their path from the repository root (the
# Makefile's -iquote .), also from headers in subdirectories.
CompileFlags:
  Add:
    - -std=c++20
    - -m64
    - -Wall
    - -Wextra
    - -iquote
    - .

---
If:
  PathExclude: .*_test\.cpp
CompileFlags:
  Add:
    - -masm=intel
    - -march=x86-64
    - -ffreestanding
    - -fno-builtin
    - -fno-exceptions
    - -fno-rtti
    - -mno-red-zone
    - -mgeneral-regs-only
    - -fno-stack-protector
    - -fno-pie
    - -U_GLIBCXX_ASSERTIONS
    - -fcf-protection=none
    - -DPROTOS_SELFTEST=1
    - -Ibuild/include

---
If:
  PathMatch: .*_test\.cpp
CompileFlags:
  Add:
    - -isystem
    - build/include

---
# Without a compilation database, clangd compiles each file in its own
# directory. Files in selftest/ include headers by their path from the
# repository root and need build/include relative to their directory.
If:
  PathMatch: selftest/.*
CompileFlags:
  Add:
    - -iquote
    - ..
    - -isystem
    - ../build/include

---
# So do files in user/ and user/*/. Non-test files in user/ are compiled with
# USER_CXXFLAGS: unlike the kernel, user programs may use the x87/MMX/SSE
# registers, and they use the kernel code model.
If:
  PathMatch: user/[^/]+
CompileFlags:
  Add:
    - -iquote
    - ..
    - -isystem
    - ../build/include

---
If:
  PathMatch: user/[^/]+/.*
CompileFlags:
  Add:
    - -iquote
    - ../..
    - -isystem
    - ../../build/include

---
If:
  PathMatch: user/.*
  PathExclude: .*_test\.cpp
CompileFlags:
  Add:
    - -mcmodel=kernel
  Remove:
    - -mgeneral-regs-only
