CompileFlags:
  Add:
    - -std=c++20
    - -m64
    - -Wall
    - -Wextra

---
If:
  PathExclude: .*_test\.cpp
CompileFlags:
  Add:
    - -masm=intel
    - -ffreestanding
    - -fno-builtin
    - -fno-exceptions
    - -fno-rtti
    - -mno-red-zone
    - -mgeneral-regs-only
    - -fno-stack-protector
    - -fno-pie
    - -DPROTOS_SELFTEST=1
    - -Ibuild/include

---
If:
  PathMatch: .*_test\.cpp
CompileFlags:
  Add:
    - -isystem
    - build/include

