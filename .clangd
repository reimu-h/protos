CompileFlags:
  Add:
    - -std=c++20
    - -m64
    - -Wall
    - -Wextra

---
If:
  PathExclude: .*_test\.cpp
CompileFlags:
  Add:
    - -masm=intel
    - -ffreestanding
    - -fno-builtin
    - -fno-exceptions
    - -fno-rtti
    - -mno-red-zone
    - -mgeneral-regs-only
    - -fno-stack-protector
    - -fno-pie
    - -DPROTOS_SELFTEST=1
    - -Ibuild/include

---
If:
  PathMatch: .*_test\.cpp
CompileFlags:
  Add:
    - -isystem
    - build/include

---
# Without a compilation database, clangd compiles each file in its own
# directory. Files in selftest/ include headers by their path from the
# repository root and need build/include relative to their directory.
If:
  PathMatch: selftest/.*
CompileFlags:
  Add:
    - -iquote
    - ..
    - -isystem
    - ../build/include
